# ============================================================================
# Meu Controle Financeiro - Variáveis de Ambiente (.env.example)
# NUNCA comite arquivos .env, .env.local ou .env.production em repositórios Git!
# Jamais coloque SUPABASE_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY em variáveis
# com prefixo NEXT_PUBLIC_ ou em código executado no navegador.
# ============================================================================

# Ambiente de execução: development | staging | production
NODE_ENV="development"
PORT="3000"
ALLOWED_ORIGIN="http://localhost:3000"

# ============================================================================
# 1. Variáveis Públicas do Frontend (Seguras para o navegador — Respeitam RLS)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_pela_chave_publicavel

# ============================================================================
# 2. Variáveis Exclusivas do Backend / Servidor (NUNCA usar NEXT_PUBLIC_)
# ============================================================================
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_substitua_Apenas_No_Servidor_Backend

# Compatibilidade temporária legada (SOMENTE NO BACKEND — nunca expor no cliente):
SUPABASE_SERVICE_ROLE_KEY=substitua_apenas_se_necessario_no_backend

# Banco de Dados PostgreSQL / Supabase (TLS obrigatório em produção: ?sslmode=require)
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA-SUPABASE]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Cache e Filas (Rate Limiting distribuído e jobs de alerta/exportação)
REDIS_URL="redis://localhost:6379"

# Chaves Criptográficas do Servidor (Gere com: openssl rand -base64 32)
ENCRYPTION_MASTER_KEY="substitua-por-chave-aleatoria-de-256-bits-gerada-via-kms"
CSRF_SECRET="substitua-por-segredo-hmac-csrf-de-alta-entropia"
SESSION_JWT_SECRET="substitua-por-segredo-jwt-de-curta-duracao"
ADMIN_API_TOKEN_HASH="substitua-pelo-hash-sha256-do-token-administrativo-interno"

# Object Storage Privado para Comprovantes (Supabase Storage / S3 - Bucket Privado)
STORAGE_BUCKET_NAME="mcf-private-attachments"
STORAGE_BUCKET_PUBLIC="false"
STORAGE_SIGNED_URL_TTL_SECONDS="300"

# E-mail Transacional Seguro (Alertas de Login, Recuperação de Senha, Confirmação)
SMTP_HOST="smtp.exemplo.local"
SMTP_PORT="587"
SMTP_FROM="seguranca@meucontrole.ficticio.local"

# Contato do Encarregado de Proteção de Dados (DPO - LGPD Art. 41)
DPO_CONTACT_EMAIL="privacidade-dpo@meucontrole.ficticio.local"
